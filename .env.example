# Development: leave DATABASE_URL empty to retain local SQLite.
NODE_ENV=development
PORT=3001
TZ=America/Sao_Paulo
DATABASE_URL=
DB_PATH=data/folga_manager.db

# Render: set NODE_ENV=production and paste the pooled Neon URL here.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Set initial credentials only in the Render environment, never in the repository.
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
