# Development: leave DATABASE_URL empty to retain local SQLite.
NODE_ENV=development
PORT=3001
TZ=America/Sao_Paulo
DATABASE_URL=
DB_PATH=data/folga_manager.db

# Runtime uses a restricted login. Never put migration credentials in this file/service.
# Render: set NODE_ENV=production and paste the pooled Neon runtime URL here.
# Create the restricted runtime role via SQL, not the Neon roles dashboard.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
COMPANY_AUTH_RESOLVER_ROLE=company_auth_resolver
DB_POOL_MAX=5
# Migration/provisioning: separate operational session with MIGRATION_DATABASE_URL.
# See docs/multiempresa-operacao.md; startup does not migrate or create administrators.
