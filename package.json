{
  "name": "folga-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc && vite build && node scripts/build-server.mjs",
    "check:deploy": "npm run build && npm run test:company && npm run test:company:postgres && npm run test:company-ops:compiled",
    "package:deploy": "pwsh -NoProfile -File scripts/package-deploy.ps1",
    "preview": "vite preview",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "cross-env ALLOW_DATABASE_RESET=1 tsx server/db/seed.ts",
    "db:reset": "cross-env ALLOW_DATABASE_RESET=1 tsx server/db/reset.ts",
    "test:backend": "node scripts/run-isolated-tests.mjs server/tests/run-tests.ts",
    "test:holidays": "node scripts/run-isolated-tests.mjs scripts/test-holidays.ts",
    "test:api": "node scripts/run-isolated-tests.mjs scripts/test-api.ts",
    "test:reports": "node scripts/run-isolated-tests.mjs scripts/test-reports.ts",
    "test:flow": "node scripts/run-isolated-tests.mjs scripts/test-manager-flow.ts",
    "test:auth": "node scripts/run-isolated-tests.mjs scripts/test-auth.ts",
    "test:regression": "node scripts/run-isolated-tests.mjs scripts/test-regression.ts",
    "test": "node scripts/run-isolated-tests.mjs server/tests/run-tests.ts scripts/test-api.ts scripts/test-reports.ts scripts/test-manager-flow.ts scripts/test-auth.ts scripts/test-regression.ts scripts/test-holidays.ts",
    "test:postgres": "cross-env TEST_DATABASE=postgres npm test",
    "test:production": "cross-env TEST_DATABASE=postgres node scripts/run-isolated-tests.mjs scripts/test-production.ts",
    "db:backup": "tsx scripts/backup.ts",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "test:company-foundation": "node --import tsx scripts/test-company-foundation.ts",
    "test:company-auth": "node scripts/run-isolated-tests.mjs scripts/test-company-auth.ts",
    "test:company-administration": "node scripts/run-isolated-tests.mjs scripts/test-company-administration.ts",
    "test:company-migration": "node scripts/run-isolated-tests.mjs scripts/test-company-migration.ts",
    "test:company-ratelimit": "node scripts/run-isolated-tests.mjs scripts/test-company-ratelimit.ts",
    "test:company-scheduling": "node scripts/run-isolated-tests.mjs scripts/test-company-scheduling.ts",
    "test:company:postgres": "cross-env TEST_DATABASE=postgres npm run test:company",
    "test:company": "npm run test:company-foundation && node scripts/run-isolated-tests.mjs scripts/test-company-migration.ts scripts/test-company-auth.ts scripts/test-company-administration.ts scripts/test-company-ratelimit.ts scripts/test-company-scheduling.ts scripts/test-company-provisioning.ts scripts/test-company-ops.ts && npm run test:company-session && npm run check:company-boundary",
    "company:ops": "node --env-file-if-exists=.env dist-server/company-ops.mjs",
    "test:company-provisioning": "node scripts/run-isolated-tests.mjs scripts/test-company-provisioning.ts",
    "test:company-session": "node --import tsx scripts/test-company-session.ts",
    "test:company:real": "node scripts/run-real-company-tests.mjs",
    "test:company-browser": "node --import tsx scripts/serve-company-browser.ts",
    "check:company-boundary": "node scripts/check-company-boundary.mjs",
    "test:company-ops": "node scripts/run-isolated-tests.mjs scripts/test-company-ops.ts",
    "test:company-ops:compiled": "cross-env TEST_COMPILED_COMPANY_OPS=1 node scripts/run-isolated-tests.mjs scripts/test-company-ops.ts",
    "company:ops:dev": "tsx scripts/company-ops.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.16.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
